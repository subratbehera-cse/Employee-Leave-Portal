# ---------------------------------------------------------------------------
# Backend (Spring Boot) — copy the relevant values into your shell/environment
# or into backend/src/main/resources/application.yml overrides before running.
# ---------------------------------------------------------------------------

# MySQL connection
DB_URL=jdbc:mysql://localhost:3306/leave_management_db?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=change-me

# Hibernate DDL strategy: update | validate | none (use "validate" or "none" in production
# once the schema has been created, to avoid accidental schema changes)
DDL_AUTO=update
SHOW_SQL=false

# JWT
# Generate a long, random value for production, e.g.: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRATION_MS=86400000

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

SERVER_PORT=8080
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Frontend (Vite + React) — copy into frontend/.env
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api
